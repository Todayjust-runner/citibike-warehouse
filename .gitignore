# Local source data and derived data: metadata manifests belong in inputs/.
/data/**
!/data/README.md
*.csv
!/inputs/required-inputs.csv
*.tsv
*.parquet
*.feather
*.zip
*.7z
*.rar

# Course materials, books, exports and recordings stay outside source control.
*.pdf
*.docx
*.pptx
*.xlsx
*.mp4
*.mov
*.avi
/output/
/artifacts/
/tmp/
/logs/

# Database files and backups.
*.mdf
*.ndf
*.ldf
*.bak
*.trn
*.dacpac
*.bacpac

# Credentials and machine configuration.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.publish.xml
*secrets*.json
appsettings.*.json
!appsettings.example.json
/config/local*
*.local.json
*.local.yaml

# Tool caches and editor files.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
dist/
.vs/
.idea/
.vscode/
bin/
obj/
*.suo
*.user
*.log
Thumbs.db
Desktop.ini
~$*
