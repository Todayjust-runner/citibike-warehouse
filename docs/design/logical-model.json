{
  "model_version": "1.0",
  "status": "B_design_baseline_not_business_signoff_or_physical_validation",
  "metric_rule_version": "A-1.0",
  "processing_policy_version": "B1-1.0",
  "business_fact": "dwd.fact_trip",
  "notes": [
    "Logical types only; SQL Server lengths, exact SQL types, indexes and DDL belong to conversation three.",
    "Every query locks one published run_id. Station display snapshots are scoped to that run; no invented source historical versions.",
    "source_timestamp is offset-free; exact integer microseconds must be representable, otherwise publication stops pending a precision decision."
  ],
  "tables": [
    {
      "name": "meta.source_member",
      "grain": "一个原始 ZIP 哈希与其一个 CSV 成员路径；空 CSV 也登记",
      "primary_key": [
        "source_member_id"
      ],
      "unique_keys": [
        [
          "zip_sha256",
          "member_path_identity"
        ]
      ],
      "fields": [
        {
          "name": "source_member_id",
          "logical_type": "integer_key",
          "nullable": false,
          "description": "成员代理键"
        },
        {
          "name": "zip_sha256",
          "logical_type": "sha256_hex",
          "nullable": false,
          "description": "完整 ZIP 字节 SHA-256；不是 ETag"
        },
        {
          "name": "zip_url",
          "logical_type": "text",
          "nullable": false,
          "description": "官方取得地址"
        },
        {
          "name": "zip_bytes",
          "logical_type": "nonnegative_integer",
          "nullable": false,
          "description": "完整压缩包字节数"
        },
        {
          "name": "zip_month_label",
          "logical_type": "year_month",
          "nullable": false,
          "description": "文件名月份标签，不是事件日期"
        },
        {
          "name": "zip_csv_member_count",
          "logical_type": "positive_integer",
          "nullable": false,
          "description": "ZIP 内全部 CSV 成员数，不只首个"
        },
        {
          "name": "archive_inventory_verified",
          "logical_type": "boolean",
          "nullable": false,
          "description": "全部成员清点并核验完成标志"
        },
        {
          "name": "member_path",
          "logical_type": "exact_string",
          "nullable": false,
          "description": "ZIP 中原始 CSV 成员路径"
        },
        {
          "name": "member_path_identity",
          "logical_type": "binary_identity",
          "nullable": false,
          "description": "member_path 的 UTF-16LE 无 BOM 字节，用于精确等值"
        },
        {
          "name": "csv_sha256",
          "logical_type": "sha256_hex",
          "nullable": false,
          "description": "解压后完整 CSV 字节 SHA-256"
        },
        {
          "name": "csv_header",
          "logical_type": "ordered_string_list",
          "nullable": false,
          "description": "原始 13 列表头与次序"
        },
        {
          "name": "csv_data_record_count",
          "logical_type": "nonnegative_integer",
          "nullable": false,
          "description": "CSV 数据记录数，不含表头"
        },
        {
          "name": "acquired_at_utc",
          "logical_type": "utc_instant",
          "nullable": false,
          "description": "取得时间；审计时间与业务时间分开"
        }
      ]
    },
    {
      "name": "meta.load_run",
