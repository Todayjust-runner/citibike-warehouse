        {
          "name": "started_at_utc",
          "logical_type": "utc_instant",
          "nullable": false,
          "description": "执行审计开始"
        },
        {
          "name": "finished_at_utc",
          "logical_type": "utc_instant",
          "nullable": true,
          "description": "执行完成，运行中可空"
        }
      ]
    },
    {
      "name": "meta.run_source",
