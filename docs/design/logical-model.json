        },
        {
          "name": "status",
          "logical_type": "enum",
          "nullable": false,
          "description": "CREATED/RUNNING/VALIDATED/PUBLISHED/FAILED"
        },
        {
          "name": "is_current",
          "logical_type": "boolean",
          "nullable": false,
